<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>disable</Nullable>
    <RootNamespace>Qiniu</RootNamespace>
    <AssemblyName>jcode.qiniu</AssemblyName>
    <Product>极简搭AI应用开发基座</Product>
    <Description>Qiniu Resource (Cloud) Storage SDK for C#（内嵌源码版）</Description>
    <Company>苏州极简搭信息技术有限公司</Company>
    <Copyright>https://www.jcodesoft.com</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Version>6.0.0</Version>
    <!-- 仅作为项目引用使用，不参与打包 -->
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <IsPackable>false</IsPackable>
    <!-- 第三方源码，不启用严格警告 -->
    <NoWarn>$(NoWarn);CS0618;CS1591;SYSLIB0014;CS0168;CS0219</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
