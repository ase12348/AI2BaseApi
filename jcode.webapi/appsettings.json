{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "ServerOp": {
    "dbConn": "DataSource=wwwroot/database/jcode.db;Pooling=True;Cache=Shared",  //【SQLite 本地数据库，相对项目目录，改目录名不受影响】
    "dbType": "Sqlite", //SqlServer,Oracle,MySql,Sqlite
    "dbIsDev": false,
    //读写分离配置
    "IsSlave": false, //是否开启读写分离
    "DbConnSlave": "[{HitRate:1,ConnectionString:xxxxx}]", //从库数据库连接字符串

    "RedisPrev": "jcode",
    "RedisDbNum": 0,
    "RedisExchangeHosts": "",
    "CacheType": "MemoryCache",

    "RoutePrefix": "",

    "IMOpen": false, //false/true
    "IMUrl": "",

    "MainServerType": "", //邮箱服务类型 exchange,其它; 默认其它
    "MailName": "极简搭邮件中心",
    "MailUserName": "",
    "MailPassword": "",
    "MailHost": "smtp.ym.163.com", // 发出邮箱设置邮箱主机【域，不是域名，域用户的的话就得填这个，选填(exchange 类型)】
    "MailDiscoverUrl": "", //Exchange发件人的邮箱地址，完整的(xx@dd.com)
    "MailApiUrl": "", //Exchange服务器上接口地址,如http://XXX/ews/Exchange.asmx
    "ExchangeVer": "", // Exchange版本，默认Exchange2016

    "CorpId": "",
    "CorpSecret": "",
    "CorpAppId": "",

    "WeixinAppId": null, //微信小程序 AppId
    "WeixinAppSecret": null, //微信小程序 AppSecret

    "JwtSecret": "jcodesoft.com", // 请保存好
    "JwtAccessExpMinutes": "60", // 访问令牌有效时间（分钟）
    "JwtRefreshGraceSeconds": "60", // 刷新令牌轮换宽限期（秒），仅 JwtRefreshSharedMode=false 时生效
    "JwtRefreshSharedMode": true, // 多人共用账号/共用登录态：刷新不轮换 jti（幂等），避免互相顶掉；设 false 恢复严格轮换+重放检测
    "JwtRefreshMaxHours": "168", // 共享模式下会话自创建起最长存活时间（小时，默认7天），给滑动续期加绝对上限

    //OCR文字识别
    "OcrAccessKeyId": "",
    "OcrAccessKeySecret": "",
    "OcrEndpoint": "ocr-api.cn-hangzhou.aliyuncs.com",

    "AnnexesType": "Db",
    "AnnexesOrphanDays": 7, // 孤儿附件保留天数
    "AnnexesDraftHours": 24, // 暂存附件保留时长（小时）
    "FilePath": "", // 附件地址
    "IsImgSaveDb": true, //图片保存用数据库

    "IsSwagger": false, // 是否开启Swagger接口文档

    // 开启文件保存加密
    "IsEncryptFile": false,
    // 文件预览，未配置项取代码默认值
    "Preview": {
      "EnableNpoi": true, // Excel 优先用 NPOI 直接渲染，失败回退 LibreOffice
      "EnableLibreOffice": true, // 未安装 LibreOffice 时相关格式直接提示下载
      "EnableClientPptx": true, // pptx 优先由前端 pptx-preview 渲染
      "OfficeConvertTimeoutSeconds": 60, // 单次转换超时（秒）
      "MaxRows": 200, // NPOI 渲染最多行数
      "MaxCols": 50, // NPOI 渲染最多列数
      "MaxFileSizeMb": 20 // 超过该大小不走 NPOI
    },
    
    "IsEnableDiffLog": false, //开启ORM文件日志记录


    "SaveLogDays": 30, // 日志保存时间(天)
    "GetIPNameClosed": false


  }
}
